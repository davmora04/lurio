# Copy to .env.local for local development. Never commit real values.

# ── Site URL & indexing ────────────────────────────────────────────────
# Public production URL (confirm the domain first). Enables canonical, sitemap URLs,
# absolute OG URLs and Organization structured data. Leave empty until confirmed.
NEXT_PUBLIC_SITE_URL=
# Set to "true" only on the confirmed production deployment. Anything else sends
# "noindex" and a disallow-all robots.txt. Vercel preview deployments are never indexed.
SITE_INDEXING=

# ── Contact form destination (configure ONE) ───────────────────────────
# Option A — webhook (CRM, Zapier/Make/n8n, custom inbox relay). Receives a JSON POST.
# Must be https (plain http is accepted only for localhost testing).
CONTACT_WEBHOOK_URL=
# Optional: sent as "Authorization: Bearer <secret>" so the receiver can verify the sender.
CONTACT_WEBHOOK_SECRET=

# Option B — email via Resend (https://resend.com). The sender domain must be verified in Resend.
RESEND_API_KEY=
# Comma-separated inbox(es) that receive inquiries, e.g. founders@lurio.co
CONTACT_TO_EMAIL=
# Verified sender, e.g. "Lurio Website <website@lurio.co>"
CONTACT_FROM_EMAIL=

# Development only: log inquiries to the server console instead of delivering them
# (ignored in production builds). Lets you test the success state locally.
CONTACT_DEV_LOG=

# ── Self-hosting with several instances (not needed on Vercel) ─────────
# Stable key shared by all instances so Server Action references stay valid.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
